{
  "name": "lancers-operations-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:slot": "node scripts/local-app-command.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "node scripts/require-local-supabase-lease.mjs",
    "test": "vitest run",
    "pretest:watch": "node scripts/require-local-supabase-lease.mjs",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "db:coordinator": "node scripts/local-supabase-coordinator.mjs",
    "db:acquire": "node scripts/local-supabase-coordinator.mjs acquire",
    "db:heartbeat": "node scripts/local-supabase-coordinator.mjs heartbeat",
    "db:review-ready": "node scripts/local-supabase-coordinator.mjs review-ready",
    "db:release": "node scripts/local-supabase-coordinator.mjs release",
    "db:cleanup-stale": "node scripts/local-supabase-coordinator.mjs cleanup-stale",
    "db:start": "node scripts/local-supabase-command.mjs start",
    "db:stop": "node scripts/local-supabase-command.mjs stop",
    "db:status": "node scripts/local-supabase-command.mjs status",
    "db:reset": "node scripts/local-supabase-command.mjs reset",
    "db:seed-user": "node scripts/local-supabase-command.mjs seed-user",
    "db:seed": "node scripts/local-supabase-command.mjs seed",
    "db:link-operator": "node scripts/local-supabase-command.mjs link-operator",
    "types:generate": "node scripts/local-supabase-command.mjs types-generate",
    "types:check": "node scripts/generate-types.mjs --check",
    "check:rls": "node scripts/check-rls-migrations.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.3.1",
    "@mui/material-nextjs": "^9.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.6",
    "supabase": "^2.113.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
