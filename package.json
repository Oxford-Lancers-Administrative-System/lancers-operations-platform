{
  "name": "lancers-operations-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:slot": "node scripts/local-app-command.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "node scripts/require-local-supabase-lease.mjs",
    "test": "vitest run --project unit --project database",
    "test:ci": "node scripts/ci-local-command.mjs test",
    "test:gate:ci": "node scripts/ci-local-command.mjs test-gate",
    "pretest:watch": "node scripts/require-local-supabase-lease.mjs",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "preverify:gate": "node scripts/require-local-supabase-lease.mjs",
    "verify:gate": "PILOT_GUARD_CHECK=1 vitest run --project gate",
    "db:coordinator": "node scripts/local-supabase-coordinator.mjs",
    "db:acquire": "node scripts/local-supabase-coordinator.mjs acquire",
    "db:acquire-mission": "node scripts/local-supabase-coordinator.mjs acquire-mission",
    "db:attach-mission": "node scripts/local-supabase-coordinator.mjs attach-mission",
    "db:heartbeat": "node scripts/local-supabase-coordinator.mjs heartbeat",
    "db:review-ready": "node scripts/local-supabase-coordinator.mjs review-ready",
    "db:release": "node scripts/local-supabase-coordinator.mjs release",
    "db:cleanup-stale": "node scripts/local-supabase-coordinator.mjs cleanup-stale",
    "db:start": "node scripts/local-supabase-command.mjs start",
    "db:stop": "node scripts/local-supabase-command.mjs stop",
    "db:status": "node scripts/local-supabase-command.mjs status",
    "db:reset": "node scripts/local-supabase-command.mjs reset",
    "db:seed-user": "node scripts/local-supabase-command.mjs seed-user",
    "db:seed-user:ci": "node scripts/ci-local-command.mjs seed-user",
    "db:seed": "node scripts/local-supabase-command.mjs seed",
    "messaging:ticker": "node scripts/messaging-ticker.mjs",
    "db:seed:ci": "node scripts/ci-local-command.mjs seed",
    "db:link-operator": "node scripts/local-supabase-command.mjs link-operator",
    "db:link-coach": "node scripts/local-supabase-command.mjs link-coach",
    "mission": "node scripts/mission/cli.mjs",
    "intake": "node scripts/intake/cli.mjs",
    "types:generate": "node scripts/local-supabase-command.mjs types-generate",
    "types:check": "node scripts/generate-types.mjs --check",
    "telemetry:harvest": "node scripts/telemetry/harvest.mjs",
    "check:rls": "node scripts/check-rls-migrations.mjs",
    "visual:preflight": "node scripts/visual-preflight.mjs",
    "visual:start": "node scripts/visual-environment.mjs start",
    "visual:status": "node scripts/visual-environment.mjs status",
    "visual:disposition": "node scripts/visual-environment.mjs disposition",
    "visual:release": "node scripts/visual-environment.mjs release",
    "mission:finish": "node scripts/mission/finish-mission.mjs",
    "templates:manifest": "node scripts/generate-template-manifest.mjs",
    "templates:check": "node scripts/generate-template-manifest.mjs --check",
    "check:messaging": "node scripts/check-messaging-config.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.3.1",
    "@mui/material-nextjs": "^9.3.0",
    "@mui/x-date-pickers": "^9.12.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "date-fns": "^4.4.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.6",
    "supabase": "^2.113.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
